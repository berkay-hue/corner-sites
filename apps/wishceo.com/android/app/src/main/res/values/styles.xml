<?xml version="1.0" encoding="utf-8"?>
<!-- Uygulama yalnız açık temada; gece modunda da aynı kâğıt rengi. -->
<resources>
    <!-- Flutter ilk kareyi çizene kadar görünen açılış ekranı. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Flutter arayüzünün arkasındaki pencere rengi. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/paper</item>
    </style>
</resources>
