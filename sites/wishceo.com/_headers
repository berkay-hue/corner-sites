/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://corner-forms.berkay-999.workers.dev https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/app.js
  Cache-Control: public, max-age=300, must-revalidate

/blog-latest.js
  Cache-Control: public, max-age=300, must-revalidate

/_blog-index.json
  Cache-Control: public, max-age=300, must-revalidate
