# app.socialmediacorner.co — Social Media Corner Stüdyo
# A3-1: script-src ve frame-src'de https://challenges.cloudflare.com (Turnstile, sitekey girilince yüklenir), connect-src'de
#       corner-forms worker'ı (/gen/*, /submit); CF Web Analytics için static.cloudflareinsights.com + cloudflareinsights.com.
# A3-4: açılışta X-Robots-Tag satırı ve sayfalardaki meta robots noindex kaldırılır (/hesap/* kalıcı noindex).
# robots.txt ve sitemap.xml yazılmaz; dist üretir.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob: https://images.pexels.com; media-src 'self' blob: https://videos.pexels.com; font-src 'self'; connect-src 'self' https://corner-forms.berkay-999.workers.dev https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/hesap/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/en/hesap/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Chatbot web widget'ı (w/sohbet.js): müşteri sitelerinden yüklenir; gömme kodu sabit, sürüm parametresiz → kısa önbellek
/w/*
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Robots-Tag: noindex
