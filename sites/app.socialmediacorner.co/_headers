# app.socialmediacorner.co — Taslak Masası
# A3-1: script-src ve frame-src'ye https://challenges.cloudflare.com (Turnstile), connect-src'ye form/üretim worker'ı;
#       istenirse static.cloudflareinsights.com + cloudflareinsights.com eklenir.
# A3-4: açılışta X-Robots-Tag satırı ve sayfalardaki meta robots noindex kaldırılır (/hesap/* kalıcı noindex).
# robots.txt ve sitemap.xml yazılmaz; dist üretir.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/hesap/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
