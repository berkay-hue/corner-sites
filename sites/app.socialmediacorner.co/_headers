# app.socialmediacorner.co — Taslak Masası
# A3-1: script-src ve frame-src'de https://challenges.cloudflare.com (Turnstile, sitekey girilince yüklenir), connect-src'de
#       corner-forms worker'ı (/gen/*, /submit); CF Web Analytics için static.cloudflareinsights.com + cloudflareinsights.com.
# A3-4: açılışta X-Robots-Tag satırı ve sayfalardaki meta robots noindex kaldırılır (/hesap/* kalıcı noindex).
# robots.txt ve sitemap.xml yazılmaz; dist üretir.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://corner-forms.berkay-999.workers.dev https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/hesap/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/en/hesap/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
